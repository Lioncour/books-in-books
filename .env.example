# Copy to .env (which is gitignored) and fill in what you use.
# Values already set in your terminal win over this file.

# --- Option A: Anthropic API key (billed to your Anthropic Console account)
# ANTHROPIC_API_KEY=

# --- Option B: Amazon Bedrock (billed to the AWS account behind the profile)
# Log in first with:  aws sso login --profile <your profile>
# BOOKS_PROVIDER=bedrock
# AWS_PROFILE=
# AWS_REGION=eu-central-1
#
# Older accounts reach models through inference profiles on the InvokeModel
# endpoint. If the default does not work for you, use these two instead:
# BOOKS_BEDROCK_API=runtime
# BOOKS_JUDGE_MODEL=eu.anthropic.claude-opus-5-5

# --- Option C: Claude Code on this machine (drawn from your Claude subscription)
# Log in first: run `claude` in a terminal and type /login
# BOOKS_PROVIDER=claude-code

# --- Optional
# BOOKS_JUDGE_MODEL=        # default: claude-opus-5-5 (anthropic.claude-opus-5-5 on Bedrock)
# BOOKS_READER=on           # let Claude read the whole book (costs more)
# BOOKS_READER_MODEL=
# BOOKS_SPACY_MODEL=en_core_web_sm
# BOOKS_READER_PASSES=2    # read each book twice (better recall, twice the price)
